---
import AddToCartIsland from "./islands/AddToCartIsland.jsx";

const { name, amount, img, productId, producto } = Astro.props;
const imgUrl = producto?.url_imagen ? `http://localhost:3000${producto.url_imagen}` : 'http://localhost:4321/img/sushi.webp';
---

<div class="plate-card" data-product-id={productId}>
  <div class="plate-img" style={`background-image: url('${imgUrl}'); background-size: cover; background-position: center;`}>
    <div class="alergies"></div>
  </div>
  <div class="plate-details">
    <h2 class="plate-name">{name}</h2>
    <p class="plate-amount">Cantidad : {amount}</p>
    <div class="plate-buttons">
      <AddToCartIsland client:load producto={producto} />
      <button 
        class="info" 
        type="button" 
        onclick={`window.location.href='/info/${productId}'`}
        style="cursor: pointer; border: none; outline: none;"
      >
        <i class="fa-solid fa-circle-info"></i> Info
      </button>
    </div>
  </div>
</div>
