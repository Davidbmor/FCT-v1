---

---

<header class="main-header">
  <div class="logo"></div>
  <div class="mesa-indicator" id="mesa-indicator" style="display: none;">
    <i class="fa-solid fa-chair"></i>
    <span>Mesa <span id="numero-mesa">-</span></span>
  </div>
  <div class="cart" id="cart-container">
    <div class="redAlert">
      <p class="number" id="cart-counter">0</p>
    </div>
    <div class="button-cart">
      <i class="fa-solid fa-cart-shopping"></i>
    </div>
  </div>
</header>

<script>
  import { socket, esEmpleado } from '../lib/socket';

  // Ocultar carrito y mesa si es empleado
  if (esEmpleado()) {
    const cartContainer = document.getElementById('cart-container');
    const mesaIndicator = document.getElementById('mesa-indicator');
    
    if (cartContainer) {
      cartContainer.style.display = 'none';
    }
    if (mesaIndicator) {
      mesaIndicator.remove();
    }
  } else {
    // Solo mostrar mesa si NO es empleado
    socket.on("asignarMesa", ({ numeroMesa }) => {
      const mesaIndicator = document.getElementById('mesa-indicator');
      const numeroMesaElement = document.getElementById('numero-mesa');
      
      if (mesaIndicator && numeroMesaElement) {
        numeroMesaElement.textContent = numeroMesa;
        mesaIndicator.style.display = 'flex';
      }
    });
  }
</script>
