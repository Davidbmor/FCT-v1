---
import Header from "../components/Header.astro";
import PlateCard from "../components/PlateCard.astro";
import Cart from "../components/Cart.astro";
import { obtenerProductos } from "../lib/api.js";
import "../assets/css/style.css";
import OptionLeftNav from "../components/OptionLeftNav.astro";
import ClientOrderGestor from "../components/ClientOrderGestor.astro";
import ProductDesc from "../components/ProductDesc.astro";
import ChatGestor from "../components/ChatGestor.astro";

const productos = await obtenerProductos();

// Obtener categorías únicas de los productos
const categorias = [...new Set(productos.map((p: any) => p.tipo))].filter(Boolean);

// Agrupar productos por categoría
const productosPorCategoria = categorias.reduce((acc: any, categoria: string) => {
  acc[categoria] = productos.filter((p: any) => p.tipo === categoria);
  return acc;
}, {});
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tori & Roll</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      crossorigin="anonymous"
    />
  </head>

  <body>
    <Header />

    <button class="sidebar-toggle sidebar-open" id="sidebarToggle">
      <i class="fas fa-times"></i>
    </button>

    <div class="flexible">
      <section class="left-nav" id="leftNav">
        <ul>
          {categorias.map((categoria: string) => (
            <OptionLeftNav 
              idReference={categoria.toLowerCase().replace(/\s+/g, '-')} 
              name={categoria} 
            />
          ))}
        </ul>
      </section>

      <section class="menu-view">
        {categorias.map((categoria: string) => {
          const idCategoria = categoria.toLowerCase().replace(/\s+/g, '-');
          const productosCategoria = productosPorCategoria[categoria];
          
          return (
            <div class="menu-section-container" id={idCategoria}>
              <h1 class="tittle-menu-section">{categoria}</h1>
              <div class="plate-cards-container">
                {productosCategoria.map((p: any) => (
                  <PlateCard
                    name={p.nombre}
                    amount={p.cantidad ?? 1}
                    img={p.url_imagen ? `http://localhost:3000${p.url_imagen}` : "/src/assets/img/sushi.webp"}
                    productId={p.id}
                    producto={p}
                  />
                ))}
              </div>
            </div>
          );
        })}
      </section>
    </div>

    <Cart />

    <ClientOrderGestor />

    <ChatGestor />

    <ProductDesc name="" description="" />

    <footer class="footer-icon">
      <div class="ClientOrderIcon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          class="wd-icon-receipts wd-icon"
          focusable="false"
          role="presentation"
          viewBox="0 0 24 24"
        >
          <g fill-rule="nonzero" class="wd-icon-container">
            <path
              d="M12 12.5c0-.3.2-.5.5-.5h3c.3 0 .5.2.5.5v1c0 .3-.2.5-.5.5h-3c-.3 0-.5-.2-.5-.5v-1zm-4-3c0-.3.2-.5.5-.5h7c.3 0 
          .5.2.5.5v1c0 .3-.2.5-.5.5h-7c-.3 0-.5-.2-.5-.5v-1zm0-3c0-.3.2-.5.5-.5h7c.3 0 .5.2.5.5v1c0 .3-.2.5-.5.5h-7c-.3 0-.5-.2-.5-.5v-1z"
              class="wd-icon-accent"></path>
            <path
              d="M4.8 21.4c-.4.3-.8.1-.8-.4V2.5c0-.3.2-.5.5-.5h15c.3 0 .5.2.5.5V21c0 .5-.4.7-.8.4L16 19l-3.7 2.8c-.2.1-.4.1-.6 
          0L8 19l-3.2 2.4zM6 4v14l2-1.5 4 3 4-3 2 1.5V4H6z"
              class="wd-icon-fill"></path>
          </g>
        </svg>
      </div>
      <div class="ChatIcon">
        <i class="fa-solid fa-comments"></i>
      </div>
    </footer>
    <script src="../assets/js/index.js"></script>
    <script src="../assets/js/categoryNav.js"></script>
    <script src="../assets/js/cartCounter.js"></script>
    <script>
      const sidebarToggle = document.getElementById('sidebarToggle');
      const leftNav = document.getElementById('leftNav');
      const menuView = document.querySelector('.menu-view');

      sidebarToggle.addEventListener('click', () => {
        leftNav.classList.toggle('closed');
        menuView.classList.toggle('expanded');
        sidebarToggle.classList.toggle('sidebar-open');
        
        // Cambiar icono: X cuando cerrado, barras cuando abierto
        const icon = sidebarToggle.querySelector('i');
        if (leftNav.classList.contains('closed')) {
          icon.classList.remove('fa-times');
          icon.classList.add('fa-bars');
        } else {
          icon.classList.remove('fa-bars');
          icon.classList.add('fa-times');
        }
      });
    </script>
  </body>
</html>
